# =============================================================================
# Loan Eligibility Engine: environment template
#
# Copy to .env (gitignored) and fill in the blanks. Never commit .env.
# `make env` does the copy and generates the local secrets for you.
# Each block says which phase first uses it. Generate secrets with:
#   openssl rand -hex 32
# Bootstrap copies the non-secret switches into the app_config table, so n8n
# workflows read them from the database and N8N_BLOCK_ENV_ACCESS_IN_NODE can stay true.
# Secrets go only into n8n credentials, SSM SecureString, or this file.
# =============================================================================

# --- Compose project and host ports (phase 1) --------------------------------
# Give each git worktree its own name and offset its ports (e.g. +100), so each
# worktree gets its own containers, volumes and app database.
COMPOSE_PROJECT_NAME=loanengine
N8N_HOST_PORT=5678
APP_DB_HOST_PORT=5433
# Local-only port for webhook-gw, used to send signed webhooks without the tunnel.
WEBHOOK_GW_HOST_PORT=8088
CLOUDFLARED_METRICS_HOST_PORT=20241
# The upload page's local server (`make ui`)
UI_HOST_PORT=8090
# local: the page calls `make ui`'s stand-ins; aws: the deployed Function URLs and bucket
UI_TARGET=local
# A third origin the Function URLs and the bucket accept (CORS), e.g. where the UI is hosted
UI_PUBLIC_ORIGIN=

# --- n8n (phase 1) -----------------------------------------------------------
# Encrypts stored credentials. If you change it later, existing credentials can't be read.
N8N_ENCRYPTION_KEY=
# Shared secret between n8n main and the external task-runners container.
N8N_RUNNERS_AUTH_TOKEN=
# Password for n8n's own metadata database (the n8n-db container).
N8N_DB_PASSWORD=
GENERIC_TIMEZONE=Asia/Kolkata

# --- Application database: the local app-db container (phase 1) --------------
APP_DB_NAME=loans
# Owner role; runs migrations.
APP_DB_ADMIN_USER=loans_admin
APP_DB_ADMIN_PASSWORD=
# Password for the n8n_app role behind n8n's Postgres credential (least privilege).
N8N_APP_DB_PASSWORD=
# Password for the lambda_app role. Local only: on RDS it authenticates with IAM tokens.
LAMBDA_APP_DB_PASSWORD=
# password (local) | iam (RDS, in-VPC Lambdas)
DB_AUTH=password

# --- Webhook from the notify Lambda to n8n Workflow B (phase 2) --------------
# The same value goes into SSM for notify and into an n8n credential (JWT, HS256) that
# verifies it. The webhook path is a fixed constant, /webhook/loan-match.
WEBHOOK_HMAC_SECRET=
# Tokens older than this are rejected, to stop replays.
WEBHOOK_MAX_SKEW_SECONDS=300

# --- LLM gateway sub-workflow (phase 2) ---------------------------------------
# gemini | groq | openrouter
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL_EXTRACT=gemini-3.5-flash-lite
LLM_MODEL_COMPARE=gemini-3.8-flash
LLM_MODEL_MATCH=gemini-3.5-flash-lite
# Free-tier limits for your AI Studio project. These are conservative placeholders
# until the real numbers are known.
LLM_RPM=10
LLM_RPD=500
LLM_MAX_RETRIES=5
# Requests the gateway sends at once, paced to stay under LLM_RPM (DECISIONS AD29). Raise it on
# a paid tier; the request size (K) is then planned from the model's measured latency.
LLM_CONCURRENCY=2

# --- Crawling, Workflow A (phase 2) ------------------------------------------
# fixtures (default; tests and the demo never touch live sites) | live
CRAWL_MODE=fixtures
CRAWL_USER_AGENT=LoanEligibilityEngine/0.1 (take-home assignment; one crawl per day)
CRAWL_DELAY_SECONDS=5
# Products not seen for this many days are marked inactive.
PRODUCT_STALE_DAYS=7
# S6: an extracted field below this confidence is not used as a SQL filter.
EXTRACTION_CONFIDENCE_MIN=0.7

# --- Matching pipeline, Workflow B (phases 2 and 4) --------------------------
# Banding for cohort signatures: threshold | coarse | fine (experiment E2)
COHORT_BANDS=threshold
# Most cohorts in one LLM call: the size validated for accuracy (experiment E3). Requests are
# smaller when the model's latency grows with output and LLM_CONCURRENCY > 1 (AD29).
LLM_BATCH_K=25
# false turns fuzzy criteria into caveats with no match-time LLM (experiment E4)
MATCH_LLM_ENABLED=true
# Second judge: each fuzzy criterion is also compiled once into rules over the exact facts,
# and the two judges vote (docs/EXPERIMENTS.md). false: cohort verdicts alone decide.
MATCH_RULES_ENABLED=true
# The sweeper picks up batches that have sat in "ingested" for longer than this.
SWEEPER_STALE_MINUTES=10

# --- Email safety, Workflow C (phase 2) --------------------------------------
# suppressed   : record notifications and send nothing (default)
# test_aliases : send only to EMAIL_ALIASES
# Workflow C refuses to run for any other value.
EMAIL_MODE=suppressed
# Hard cap on emails per run. It must not exceed the number of aliases.
EMAIL_CAP=2
# Comma-separated. Every address must be verified in SES (sandbox) in AWS_REGION.
EMAIL_ALIASES=shivaset2+1@gmail.com,shivaset2+2@gmail.com
SES_SENDER=shivaset2@gmail.com
# The SES sandbox allows one message per second.
SES_MAX_PER_SECOND=1

# --- AWS (phase 3) ---------------------------------------------------------------
# The only place the region is set: n8n's SES credential, app_config, the Lambdas and
# serverless.yml all read it from here. Sydney, because this account's simplified sign-up
# pins it to one region (docs/DECISIONS.md AD27).
AWS_REGION=ap-southeast-2
# Named AWS CLI profile for deploys and make targets. Admin keys stay in that profile and
# must never be copied into an n8n credential.
AWS_PROFILE=default
STAGE=dev
SSM_PREFIX=/loan-engine/dev
# Your public IP as a /32. It's the only non-Lambda source RDS accepts.
MY_IP_CIDR=
# Access key for the SES-only IAM user behind n8n's AWS credential (created before 2d).
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
# Serverless Framework v4 access key (app.serverless.com, Settings > Access Keys).
SERVERLESS_ACCESS_KEY=
# Upload guard rails for the presign Lambda.
UPLOAD_MAX_BYTES=52428800
PRESIGN_EXPIRES_SECONDS=300

# --- RDS (phase 3; host comes from stack outputs) ----------------------------
RDS_HOST=
RDS_PORT=5432
RDS_DB_NAME=loans
RDS_MASTER_USER=loans_admin
# Generated by make env. Kept only here and in SSM SecureString (no Secrets Manager).
RDS_MASTER_PASSWORD=
RDS_N8N_APP_PASSWORD=
# AWS RDS CA bundle, mounted into n8n so TLS to RDS is verified.
RDS_CA_BUNDLE=certs/rds-global-bundle.pem
